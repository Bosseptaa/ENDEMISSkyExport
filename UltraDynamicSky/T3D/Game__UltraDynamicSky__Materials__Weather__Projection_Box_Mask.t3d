   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/UltraDynamicSky/Materials/Weather/Projection_Box_Mask.Projection_Box_Mask:MaterialExpressionCustom_0'"
      Code="float CurColor=0;\r\nfloat2 NewUV = UV;\r\nint i=0;\r\nfloat StepSize = Distance / (int) DistanceSteps;\r\nfloat CurDistance=0;\r\nfloat2 CurOffset=0;\r\nfloat SubOffset = 0;\r\nfloat TwoPi = 6.283185;\r\nfloat accumdist=0;\r\nfloat CurSample;\r\n\r\nwhile ( i < (int) DistanceSteps)\r\n{\r\n\tCurDistance += StepSize;\r\n\tfor (int j = 0; j < (int) RadialSteps; j++)\r\n\t{\r\nSubOffset +=1;\r\nCurOffset.x = cos(TwoPi*(SubOffset / RadialSteps));\r\nCurOffset.y = sin(TwoPi*(SubOffset / RadialSteps)) * YScale;\r\n\t\tNewUV.x = UV.x + CurOffset.x * CurDistance;\r\n\t\tNewUV.y = UV.y + CurOffset.y * CurDistance;\r\n\t\tCurSample = Tex.SampleGrad(TexSampler,NewUV,0, 0).x;\r\n\t\tCurSample -= DepthRange;\r\n\t\tCurSample = saturate(sign(CurSample));\r\n\t\tCurColor += CurSample*CurDistance;\t\t\r\n\t\taccumdist += CurDistance;\r\n\t}\r\nSubOffset +=RadialOffset;\r\ni++;\r\n}\r\nCurColor /=accumdist;\r\nreturn CurColor;"
      OutputType=CMOT_Float1
      Description="Blur"
      Inputs(0)=(InputName="Tex",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'Projection_Box_Mask:MaterialExpressionTextureObjectParameter_1'"))
      Inputs(1)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'Projection_Box_Mask:MaterialExpressionTextureCoordinate_2'"))
      Inputs(2)=(InputName="Distance",Input=(Expression="/Script/Engine.MaterialExpressionMultiply'Projection_Box_Mask:MaterialExpressionMultiply_4'"))
      Inputs(3)=(InputName="DistanceSteps",Input=(Expression="/Script/Engine.MaterialExpressionConstant'Projection_Box_Mask:MaterialExpressionConstant_3'"))
      Inputs(4)=(InputName="RadialSteps",Input=(Expression="/Script/Engine.MaterialExpressionConstant'Projection_Box_Mask:MaterialExpressionConstant_4'"))
      Inputs(5)=(InputName="RadialOffset",Input=(Expression="/Script/Engine.MaterialExpressionConstant'Projection_Box_Mask:MaterialExpressionConstant_5'"))
      Inputs(6)=(InputName="DepthRange",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'Projection_Box_Mask:MaterialExpressionScalarParameter_9'"))
      Inputs(7)=(InputName="YScale",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'Projection_Box_Mask:MaterialExpressionScalarParameter_11'"))
