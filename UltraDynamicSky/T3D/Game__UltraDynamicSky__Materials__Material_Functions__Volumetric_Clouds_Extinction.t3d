   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/UltraDynamicSky/Materials/Material_Functions/Volumetric_Clouds_Extinction.Volumetric_Clouds_Extinction:MaterialExpressionCustom_0'"
      Code="float Result = 0.5;\r\nfloat Strength = 1;\r\n\r\nwhile (Octaves > 0.3) {\r\n\r\nResult += (Tex.SampleLevel(TexSampler,frac(UVW),0, 0).x - 0.55) * Strength * saturate(Octaves * 4);\r\n\r\nStrength *= 0.6;\r\n\r\nUVW *= 2;\r\n\r\nOctaves -= 1;\r\n}\r\n\r\nreturn Result;"
      OutputType=CMOT_Float1
      Description="Sample HF Noise"
      Inputs(0)=(InputName="Tex",Input=(Expression="/Script/Engine.MaterialExpressionNamedRerouteUsage'Volumetric_Clouds_Extinction:MaterialExpressionNamedRerouteUsage_13'"))
      Inputs(1)=(InputName="UVW",Input=(Expression="/Script/Engine.MaterialExpressionAdd'Volumetric_Clouds_Extinction:MaterialExpressionAdd_0'"))
      Inputs(2)=(InputName="Octaves",Input=(Expression="/Script/Engine.MaterialExpressionMin'Volumetric_Clouds_Extinction:MaterialExpressionMin_0'"))
      MaterialExpressionEditorX=-4992
      MaterialExpressionEditorY=-1024
      MaterialExpressionGuid=50337D474E3961138FDA7D8880391053
      Function="/Script/Engine.MaterialFunction'Volumetric_Clouds_Extinction'"
   End Object
