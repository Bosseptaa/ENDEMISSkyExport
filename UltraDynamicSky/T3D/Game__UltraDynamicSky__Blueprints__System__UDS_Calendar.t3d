   NewVariables(0)=(VarName="Months",VarGuid=A4EA2E894707E596EF8D2FAA23894348,VarType=(PinCategory="string",ContainerType=Map),FriendlyName="Months",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=65541,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="All of the months in this calendar, and the number of days in each month (without leap years). The order of the entries in this map determines the order of the months in the calendar.")))
   NewVariables(1)=(VarName="Uses Leap Year",VarGuid=9FFA11BD4C12059DDEB3FAB3CC7CE076,VarType=(PinCategory="bool"),FriendlyName="Uses Leap Year",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=65541,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="If true, a day will be added (to the month set by Leap Year Month) when the year is a leap year. In checking if a year is a leap year, the gregorian logic is assumed.")))
   NewVariables(2)=(VarName="Leap Year Month",VarGuid=D456568C4BDB0765FD3D8AABC3CB40B8,VarType=(PinCategory="int"),FriendlyName="Leap Year Month",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=65541,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="The month which gets an extra day in a leap year, if Uses Leap Year is true. In the gregorian calendar, this would be February, so 2.")))
   NewVariables(3)=(VarName="Winter Solstice Offset",VarGuid=67C7C4A346F54105955041831947A3F9,VarType=(PinCategory="int"),FriendlyName="Winter Solstice Offset",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=65541,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Defines the day which corresponds to the winter solstice, relative to the first day of the year. This is what sets how seasons align to the calendar\'s year.")))
