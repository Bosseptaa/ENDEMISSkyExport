   NewVariables(16)=(VarName="Physical Materials which enable DLWE Interactions on non-Landscapes",VarGuid=DF46C1904E895B0B8144488B702EA8CA,VarType=(PinCategory="object",PinSubCategoryObject="/Script/CoreUObject.Class'/Script/PhysicsCore.PhysicalMaterial'",ContainerType=Array),FriendlyName="Physical Materials Which Enable DLWE Interactions On Non- Landscapes",Category=INVTEXT("Interactions"),PropertyFlags=5,MetaDataArray=((DataKey="tooltip",DataValue="If the DLWE Interaction components touch surfaces with any of these physical materials, they will respond as if they\'re touching a landscape. Useful for using DLWE effects on things other than landscapes, like static meshes.")))
