   NewVariables(18)=(VarName="General Surface Impact Sounds",VarGuid=6A6094684A19B1C6D576B6B40838C900,VarType=(PinCategory="object",PinSubCategoryObject="/Script/CoreUObject.Class'/Script/PhysicsCore.PhysicalMaterial'",PinValueType=(TerminalCategory="object",TerminalSubCategoryObject="/Script/CoreUObject.Class'/Script/Engine.SoundBase'"),ContainerType=Map),FriendlyName="General Surface Impact Sounds",Category=NSLOCTEXT("", "B34EAA66477981E286B7328C9507AE10", "General Surface Response"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="If this map has contents, the component will play impact sounds based on the physical material it detects with its collision trace. These sounds will not play if snow or puddle impact sounds are playing instead.")))
