   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/UltraDynamicSky/Materials/Material_Functions/Aurora.Aurora:MaterialExpressionCustom_1'"
      Code="float Total = 0;\r\nfloat i = 0;\r\nfloat2 TestUV;\r\nfloat Sample1;\r\nfloat Sample2;\r\n\r\nwhile (i < Steps) {\r\nTestUV = (UV * (1 + (ScalePerStep * i)));\r\n\r\nSample1 = Texture.SampleLevel(TextureSampler, TestUV + Movement1, Mip, 0).y;\r\n\r\nSample2 = Texture.SampleLevel(TextureSampler, TestUV * 0.85 + Movement2, Mip, 0).y;\r\n\r\nSample1 = 1 - abs(Sample1 - Sample2);\r\n\r\nSample1 = pow(Sample1, AuroraPower) * (1.2 - i / Steps) * saturate(Steps - i);\r\n\r\nSample1 *= 1 - (i / Steps);\r\n\r\nTotal += Sample1;\r\n\r\ni++;\r\n}\r\nreturn Total;"
