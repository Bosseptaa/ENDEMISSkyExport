   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/UltraDynamicSky/Materials/Weather/Post_Process_Wind_Fog_Color.Post_Process_Wind_Fog_Color:MaterialExpressionCustom_0'"
      Code="float Sample;\r\nfloat3 TestLoc;\r\nfloat3 VolumeCoordinate;\r\nfloat Total = 0;\r\nfloat SampleDistance = StepDistance;\r\n\r\nwhile (SampleDistance < MaxDistance) {\r\nTestLoc = (SampleDistance * CameraVector) + StartLoc;\r\nVolumeCoordinate = (TestLoc - VolumeCorner) / VolumeSize;\r\nSample = Cells.SampleGrad(CellsSampler, (TestLoc + NoiseOffset) / NoiseScale, 0,0).x;\r\n\r\nSample *= 1 - (SparseVolume.SampleGrad(SparseVolumeSampler, VolumeCoordinate, 0, 0).z);\r\n\r\nTotal += Sample * saturate((MaxDistance - SampleDistance) / StepDistance);\r\n\r\nSampleDistance += StepDistance;\r\n}\r\n\r\nreturn Total;"
      OutputType=CMOT_Float1
      Description="Fog Samples"
      Inputs(0)=(InputName="StartLoc",Input=(Expression="/Script/Engine.MaterialExpressionCameraPositionWS'Post_Process_Wind_Fog_Color:MaterialExpressionCameraPositionWS_1'"))
      Inputs(1)=(InputName="Cells",Input=(Expression="/Script/Engine.MaterialExpressionTextureObject'Post_Process_Wind_Fog_Color:MaterialExpressionTextureObject_1'"))
      Inputs(2)=(InputName="MaxDistance",Input=(Expression="/Script/Engine.MaterialExpressionNamedRerouteUsage'Post_Process_Wind_Fog_Color:MaterialExpressionNamedRerouteUsage_2'"))
      Inputs(3)=(InputName="StepDistance",Input=(Expression="/Script/Engine.MaterialExpressionNamedRerouteUsage'Post_Process_Wind_Fog_Color:MaterialExpressionNamedRerouteUsage_3'"))
      Inputs(4)=(InputName="CameraVector",Input=(Expression="/Script/Engine.MaterialExpressionNamedRerouteUsage'Post_Process_Wind_Fog_Color:MaterialExpressionNamedRerouteUsage_8'"))
      Inputs(5)=(InputName="NoiseScale",Input=(Expression="/Script/Engine.MaterialExpressionDivide'Post_Process_Wind_Fog_Color:MaterialExpressionDivide_5'"))
      Inputs(6)=(InputName="NoiseOffset",Input=(Expression="/Script/Engine.MaterialExpressionDivide'Post_Process_Wind_Fog_Color:MaterialExpressionDivide_6'"))
      Inputs(7)=(InputName="SparseVolume",Input=(Expression="/Script/Engine.MaterialExpressionTextureObject'Post_Process_Wind_Fog_Color:MaterialExpressionTextureObject_3'"))
      Inputs(8)=(InputName="VolumeCorner",Input=(Expression="/Script/Engine.MaterialExpressionComponentMask'Post_Process_Wind_Fog_Color:MaterialExpressionComponentMask_12'"))
      Inputs(9)=(InputName="VolumeSize",Input=(Expression="/Script/Engine.MaterialExpressionComponentMask'Post_Process_Wind_Fog_Color:MaterialExpressionComponentMask_13'"))
      MaterialExpressionEditorX=-236
      MaterialExpressionEditorY=92
      MaterialExpressionGuid=07F0BC48475B8C8E52605C8DACAD12FC
      Function="/Script/Engine.MaterialFunction'Post_Process_Wind_Fog_Color'"
      Desc="Does a number of 3D texture samples based on distance from the camera"
      bCommentBubbleVisible=True
   End Object
