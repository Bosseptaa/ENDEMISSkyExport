   End Object
   Description="To be used with Ultra Dynamic Sky. Outputs either the Sun or Moon vector, depending on which is active (the moon will be active if the sun is down). Also outputs a 0 to 1 value which goes down to 0 right when the vector changes which light it represents, to be used to mask the changeover with whatever effect this is used for."
   UserExposedCaption="Active Sun or Moon Vector"
   bExposeToLibrary=True
   LibraryCategoriesText(0)=NSLOCTEXT("", "42048088478AC58D73AC778335501FF1", "Ultra Dynamic Sky")
   EditorOnlyData="/Script/Engine.MaterialFunctionEditorOnlyData'Active_Sun_or_Moon_VectorEditorOnlyData'"
