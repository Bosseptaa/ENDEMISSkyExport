   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/SkyCreatorPlugin/Materials/Functions/MF_SC_Blur_SceneColor.MF_SC_Blur_SceneColor:MaterialExpressionCustom_0'"
      Code="#define TWO_PI (6.28318530717f)\r\n\r\nfloat2 UV = ScreenAlignedPosition(Parameters.ScreenPosition).xy;\r\nfloat3 Color = float3(0, 0, 0);\r\n\r\nfloat gradientNoise = TWO_PI * InterleavedGradientNoise(ScreenSize);\r\n\r\nfor (int i = 0; i < Samples; i++)\r\n{\r\n//\tfloat2 Offset = UV + PoissonDisk256[i] * Distance;\r\n\tfloat2 Offset = VogelDiskSample(i, Samples, gradientNoise);\r\n\tfloat2 ClampedOffset = ClampSceneTextureUV(UV + Offset * Distance, 14);\r\n\tfloat3 PixelColor = DecodeSceneColorForMaterialNode(ClampedOffset);\r\n\tColor += PixelColor;\r\n}\r\n\r\nreturn Color / Samples;"
      Description="Vogel Disk Blur - Scene Color"
      Inputs(0)=(InputName="SceneColor",Input=(Expression="/Script/Engine.MaterialExpressionSceneColor'MF_SC_Blur_SceneColor:MaterialExpressionSceneColor_0'"))
      Inputs(1)=(InputName="Distance",Input=(Expression="/Script/Engine.MaterialExpressionNamedRerouteUsage'MF_SC_Blur_SceneColor:MaterialExpressionNamedRerouteUsage_0'"))
      Inputs(2)=(InputName="Samples",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_SC_Blur_SceneColor:MaterialExpressionFunctionInput_3'"))
      Inputs(3)=(InputName="ScreenSize",Input=(Expression="/Script/Engine.MaterialExpressionMultiply'MF_SC_Blur_SceneColor:MaterialExpressionMultiply_1'"))
      IncludeFilePaths(0)="/Plugin/SkyCreatorPlugin/SkyCreatorCommon.ush"
      MaterialExpressionEditorX=-384
      MaterialExpressionEditorY=32
      MaterialExpressionGuid=AA13170B4A060DB806CED59651FDCF3A
      Function="/Script/Engine.MaterialFunction'MF_SC_Blur_SceneColor'"
   End Object
   Begin Object Name="MaterialExpressionCustom_25" ExportPath="/Script/Engine.MaterialExpressionCustom'/SkyCreatorPlugin/Materials/Functions/MF_SC_Blur_SceneColor.MF_SC_Blur_SceneColor:MaterialExpressionCustom_25'"
      Code="float2 UV = ScreenAlignedPosition(Parameters.ScreenPosition).xy;\r\nfloat3 Color = float3(0, 0, 0);\r\n\r\nfor (int i = 0; i < Samples; i++)\r\n{\r\n\tfloat2 Offset = UV + PoissonDisk256[i] * Distance;\r\n\tfloat2 ClampedOffset = ClampSceneTextureUV(Offset, 14);\r\n\tfloat3 PixelColor = DecodeSceneColorForMaterialNode(ClampedOffset);\r\n\tColor += PixelColor;\r\n}\r\n\r\nreturn Color / Samples;"
      Description="Poisson Disk Blur - Scene Color"
      Inputs(0)=(InputName="SceneColor",Input=(Expression="/Script/Engine.MaterialExpressionSceneColor'MF_SC_Blur_SceneColor:MaterialExpressionSceneColor_0'"))
      Inputs(1)=(InputName="Distance",Input=(Expression="/Script/Engine.MaterialExpressionNamedRerouteUsage'MF_SC_Blur_SceneColor:MaterialExpressionNamedRerouteUsage_0'"))
      Inputs(2)=(InputName="Samples",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_SC_Blur_SceneColor:MaterialExpressionFunctionInput_3'"))
      IncludeFilePaths(0)="/Plugin/SkyCreatorPlugin/SkyCreatorCommon.ush"
      MaterialExpressionEditorX=-384
      MaterialExpressionEditorY=256
      MaterialExpressionGuid=AA13170B4A060DB806CED59651FDCF3A
      Function="/Script/Engine.MaterialFunction'MF_SC_Blur_SceneColor'"
   End Object
