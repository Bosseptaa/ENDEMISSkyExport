   Begin Object Name="MaterialExpressionConstant_0" ExportPath="/Script/Engine.MaterialExpressionConstant'/SkyCreatorPlugin/Materials/Functions/MF_SC_Blur_SceneColor.MF_SC_Blur_SceneColor:MaterialExpressionConstant_0'"
      R=1.000000
      MaterialExpressionEditorX=-640
