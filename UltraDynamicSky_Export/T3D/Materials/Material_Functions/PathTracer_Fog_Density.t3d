   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/UltraDynamicSky/Materials/Material_Functions/PathTracer_Fog_Density.PathTracer_Fog_Density:MaterialExpressionCustom_0'"
      Code="float Distance = RayLength;\r\nfloat Opacity = 0;\r\nfloat StepDensity = 0;\r\nfloat StepLength = RayLength / Steps;\r\nfloat StepFraction = 0;\r\nfloat StepZ = 0;\r\nfloat StepExp = 0;\r\nfloat StepCount = 0;\r\n\r\nif (DistantCheckDepth > MaxRayLength) {\r\nreturn FogSkyOpacity;\r\n}\r\n\r\nif (RayLength == 0) {\r\nreturn 0;\r\n}\r\n\r\nwhile (StepCount <= Steps) {\r\n\r\nStepFraction = saturate(StepCount / Steps);\r\n\r\nStepZ = lerp(RayStartZ, RayEndZ, StepFraction);\r\n\r\nStepExp = exp((StepZ + 1) * HeightFalloff * -1);\r\n\r\nStepExp = clamp(StepExp, 0, 150);\r\n\r\nStepDensity = FogDensity * StepExp;\r\n\r\nOpacity += 1 - exp(StepDensity * (-1 * StepLength));\r\n\r\nStepCount += 1;\r\n\r\n}\r\n\r\nreturn Opacity;"
      OutputType=CMOT_Float1
      Description="Exponential Height Fog Opacity"
      Inputs(0)=(InputName="RayStartZ",Input=(Expression="/Script/Engine.MaterialExpressionSubtract'PathTracer_Fog_Density:MaterialExpressionSubtract_6'"))
      Inputs(1)=(InputName="RayEndZ",Input=(Expression="/Script/Engine.MaterialExpressionSubtract'PathTracer_Fog_Density:MaterialExpressionSubtract_2'"))
      Inputs(2)=(InputName="HeightFalloff",Input=(Expression="/Script/Engine.MaterialExpressionDivide'PathTracer_Fog_Density:MaterialExpressionDivide_2'"))
      Inputs(3)=(InputName="Steps",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'PathTracer_Fog_Density:MaterialExpressionFunctionInput_4'"))
      Inputs(4)=(InputName="RayLength",Input=(Expression="/Script/Engine.MaterialExpressionReroute'PathTracer_Fog_Density:MaterialExpressionReroute_2'"))
      Inputs(5)=(InputName="FogDensity",Input=(Expression="/Script/Engine.MaterialExpressionDivide'PathTracer_Fog_Density:MaterialExpressionDivide_0'"))
      Inputs(6)=(InputName="MaxRayLength",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'PathTracer_Fog_Density:MaterialExpressionFunctionInput_6'"))
      Inputs(7)=(InputName="DistantCheckDepth",Input=(Expression="/Script/Engine.MaterialExpressionReroute'PathTracer_Fog_Density:MaterialExpressionReroute_0'"))
      Inputs(8)=(InputName="FogSkyOpacity",Input=(Expression="/Script/Engine.MaterialExpressionPower'PathTracer_Fog_Density:MaterialExpressionPower_1'"))
      MaterialExpressionEditorX=-360
      MaterialExpressionEditorY=296
      MaterialExpressionGuid=BD2250E44A057FB92460AEB069633EE4
      Function="/Script/Engine.MaterialFunction'PathTracer_Fog_Density'"
   End Object
