   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/UltraDynamicSky/Materials/Weather/Projection_Box_Height.Projection_Box_Height:MaterialExpressionCustom_0'"
      Code="float CurSample = 0;\r\nint i = 0;\r\nfloat Minimum = 100000;\r\n\r\nMinimum = Tex.SampleGrad(TexSampler,UV,0, 0).x;\r\n\r\nwhile (i < 4) {\r\n\r\nCurSample = Tex.SampleGrad(TexSampler,UV + (Offset.xy * AspectScale),0, 0).x;\r\n\r\nMinimum = min(Minimum, CurSample);\r\n\r\nOffset = Offset.yzwx;\r\n\r\ni ++;\r\n\r\n}\r\n\r\nreturn Minimum;"
      OutputType=CMOT_Float1
      Inputs(0)=(InputName="Tex",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'Projection_Box_Height:MaterialExpressionTextureObjectParameter_1'"))
      Inputs(1)=(InputName="Offset",Input=(Expression="/Script/Engine.MaterialExpressionConstant4Vector'Projection_Box_Height:MaterialExpressionConstant4Vector_0'",Mask=1,MaskR=1,MaskG=1,MaskB=1,MaskA=1))
      Inputs(2)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'Projection_Box_Height:MaterialExpressionTextureCoordinate_3'"))
      Inputs(3)=(InputName="AspectScale",Input=(Expression="/Script/Engine.MaterialExpressionMultiply'Projection_Box_Height:MaterialExpressionMultiply_1'"))
      ShowCode=True
      MaterialExpressionEditorX=2112
      MaterialExpressionEditorY=972
      MaterialExpressionGuid=A0E73BD44BD6890DF49F6FBCB4462F53
      Material="/Script/Engine.Material'Projection_Box_Height'"
   End Object
