   Begin Object Name="MaterialExpressionCustom_3" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/UltraDynamicSky/Materials/Weather/Snow_Fade_Target_Mat.Snow_Fade_Target_Mat:MaterialExpressionCustom_3'"
      Code="float CurColor=0;\r\nfloat2 NewUV = UV;\r\nint i=0;\r\nfloat StepSize = Distance / (int) DistanceSteps;\r\nfloat CurDistance=0;\r\nfloat2 CurOffset=0;\r\nfloat SubOffset = 0;\r\nfloat TwoPi = 6.283185;\r\nfloat accumdist=0;\r\n\r\nif (DistanceSteps < 1)\r\n\r\n{\r\nreturn Texture2DSample(Tex,TexSampler,UV).x;\t\t\r\n}\r\nelse\r\n{\r\nwhile ( i < (int) DistanceSteps)\r\n{\r\n\tCurDistance += StepSize;\r\n\tfor (int j = 0; j < (int) RadialSteps; j++)\r\n\t{\r\nSubOffset +=1;\r\nCurOffset.x = cos(TwoPi*(SubOffset / RadialSteps));\r\nCurOffset.y = sin(TwoPi*(SubOffset / RadialSteps));\r\n\t\tNewUV.x = UV.x + CurOffset.x * CurDistance;\r\n\t\tNewUV.y = UV.y + CurOffset.y * CurDistance;\r\n\t\tfloat distpow = pow(CurDistance, KernelPower);\r\n\t\tCurColor += Texture2DSample(Tex,TexSampler,NewUV).x*distpow;\t\t\r\n\t\taccumdist += distpow;\r\n\t}\r\nSubOffset +=RadialOffset;\r\ni++;\r\n}\r\nCurColor = CurColor;\r\nCurColor /=accumdist;\r\nreturn CurColor;\r\n}"
      OutputType=CMOT_Float1
      Inputs(0)=(InputName="Tex",Input=(Expression="/Script/Engine.MaterialExpressionTextureObject'Snow_Fade_Target_Mat:MaterialExpressionTextureObject_0'"))
      Inputs(1)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'Snow_Fade_Target_Mat:MaterialExpressionTextureCoordinate_0'"))
      Inputs(2)=(InputName="Distance",Input=(Expression="/Script/Engine.MaterialExpressionConstant'Snow_Fade_Target_Mat:MaterialExpressionConstant_1'"))
      Inputs(3)=(InputName="DistanceSteps",Input=(Expression="/Script/Engine.MaterialExpressionConstant'Snow_Fade_Target_Mat:MaterialExpressionConstant_2'"))
      Inputs(4)=(InputName="RadialSteps",Input=(Expression="/Script/Engine.MaterialExpressionConstant'Snow_Fade_Target_Mat:MaterialExpressionConstant_3'"))
      Inputs(5)=(InputName="RadialOffset",Input=(Expression="/Script/Engine.MaterialExpressionConstant'Snow_Fade_Target_Mat:MaterialExpressionConstant_0'"))
      Inputs(6)=(InputName="KernelPower",Input=(Expression="/Script/Engine.MaterialExpressionConstant'Snow_Fade_Target_Mat:MaterialExpressionConstant_4'"))
      MaterialExpressionEditorX=-52
      MaterialExpressionEditorY=500
      MaterialExpressionGuid=94228BE74CEC205A083E1082B0E2A6C5
      Material="/Script/Engine.Material'Snow_Fade_Target_Mat'"
   End Object
