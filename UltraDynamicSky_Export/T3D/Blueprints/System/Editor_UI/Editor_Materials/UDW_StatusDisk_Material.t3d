   Begin Object Name="MaterialExpressionCustom_3" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/UltraDynamicSky/Blueprints/System/Editor_UI/Editor_Materials/UDW_StatusDisk_Material.UDW_StatusDisk_Material:MaterialExpressionCustom_3'"
      Code="float CurColor=0;\r\nfloat2 NewUV = UV;\r\nint i=0;\r\nfloat StepSize = Distance / (int) DistanceSteps;\r\nfloat CurDistance=0;\r\nfloat2 CurOffset=0;\r\nfloat SubOffset = 0;\r\nfloat TwoPi = 6.283185;\r\nfloat accumdist=0;\r\n\r\nif (DistanceSteps < 1)\r\n\r\n{\r\nreturn Texture2DSample(Tex,TexSampler,UV).w;\t\t\r\n}\r\nelse\r\n{\r\nwhile ( i < (int) DistanceSteps)\r\n{\r\n\tCurDistance += StepSize;\r\n\tfor (int j = 0; j < (int) RadialSteps; j++)\r\n\t{\r\nSubOffset +=1;\r\nCurOffset.x = cos(TwoPi*(SubOffset / RadialSteps));\r\nCurOffset.y = sin(TwoPi*(SubOffset / RadialSteps));\r\n\t\tNewUV.x = UV.x + CurOffset.x * CurDistance;\r\n\t\tNewUV.y = UV.y + CurOffset.y * CurDistance;\r\n\t\tfloat distpow = pow(CurDistance, KernelPower);\r\n\t\tCurColor += Texture2DSample(Tex,TexSampler,NewUV).w*distpow;\t\t\r\n\t\taccumdist += distpow;\r\n\t}\r\nSubOffset +=RadialOffset;\r\ni++;\r\n}\r\nCurColor = CurColor;\r\nCurColor /=accumdist;\r\nreturn CurColor;\r\n}"
      Inputs(0)=(InputName="Tex",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'UDW_StatusDisk_Material:MaterialExpressionTextureObjectParameter_0'"))
      Inputs(1)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionAdd'UDW_StatusDisk_Material:MaterialExpressionAdd_0'"))
      Inputs(2)=(InputName="Distance",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'UDW_StatusDisk_Material:MaterialExpressionScalarParameter_0'"))
      Inputs(3)=(InputName="DistanceSteps",Input=(Expression="/Script/Engine.MaterialExpressionConstant'UDW_StatusDisk_Material:MaterialExpressionConstant_2'"))
      Inputs(4)=(InputName="RadialSteps",Input=(Expression="/Script/Engine.MaterialExpressionConstant'UDW_StatusDisk_Material:MaterialExpressionConstant_3'"))
      Inputs(5)=(InputName="RadialOffset",Input=(Expression="/Script/Engine.MaterialExpressionConstant'UDW_StatusDisk_Material:MaterialExpressionConstant_4'"))
      Inputs(6)=(InputName="KernelPower",Input=(Expression="/Script/Engine.MaterialExpressionConstant'UDW_StatusDisk_Material:MaterialExpressionConstant_6'"))
      MaterialExpressionEditorX=2316
      MaterialExpressionEditorY=1376
      MaterialExpressionGuid=F447095043C7BE656FC8C8B91F74E5AD
      Material="/Script/Engine.Material'UDW_StatusDisk_Material'"
   End Object
