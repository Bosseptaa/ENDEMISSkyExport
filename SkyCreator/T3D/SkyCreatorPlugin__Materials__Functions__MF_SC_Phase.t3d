   Begin Object Name="MaterialExpressionCustom_11" ExportPath="/Script/Engine.MaterialExpressionCustom'/SkyCreatorPlugin/Materials/Functions/MF_SC_Phase.MF_SC_Phase:MaterialExpressionCustom_11'"
      Code="float phaseIn = saturate(dot(SunLightDir, -normalize(CameraPos-WorldPos)));\r\nfloat phaseUni = 1.0;\r\nfloat k = Ink;// 0.8;\r\nfloat factor = 1.0 - k * phaseIn;\r\nfloat phaseSchlick = (1.0 - k*k) / (factor*factor);\r\n\r\nfloat phase = (0.3*phaseUni + 0.7*phaseSchlick) / (4.0 * PI);\r\n\r\nreturn phase;"
      OutputType=CMOT_Float1
      Description="Phase"
      Inputs(0)=(InputName="SunLightDir",Input=(Expression="/Script/Engine.MaterialExpressionSkyAtmosphereLightDirection'MF_SC_Phase:MaterialExpressionSkyAtmosphereLightDirection_4'"))
      Inputs(1)=(InputName="CameraPos",Input=(Expression="/Script/Engine.MaterialExpressionCameraPositionWS'MF_SC_Phase:MaterialExpressionCameraPositionWS_2'"))
      Inputs(2)=(InputName="WorldPos",Input=(Expression="/Script/Engine.MaterialExpressionWorldPosition'MF_SC_Phase:MaterialExpressionWorldPosition_4'"))
      Inputs(3)=(InputName="Ink",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_SC_Phase:MaterialExpressionFunctionInput_1'"))
      MaterialExpressionEditorX=-768
      MaterialExpressionEditorY=512
      MaterialExpressionGuid=D9E0036C43A38D3B59F5F489D5506C4B
      Function="/Script/Engine.MaterialFunction'MF_SC_Phase'"
   End Object
   Begin Object Name="MaterialExpressionCustom_7" ExportPath="/Script/Engine.MaterialExpressionCustom'/SkyCreatorPlugin/Materials/Functions/MF_SC_Phase.MF_SC_Phase:MaterialExpressionCustom_7'"
      Code="float phaseIn = saturate(dot(SunLightDir, -normalize(CameraPos-WorldPos)));\r\nfloat phaseUni = 1.0;\r\nfloat k = Ink;// 0.8;\r\nfloat factor = 1.0 - k * phaseIn;\r\nfloat phaseSchlick = (1.0 - k*k) / (factor*factor);\r\n\r\nfloat phase = (0.3*phaseUni + 0.7*phaseSchlick) / (4.0 * PI);\r\n\r\nreturn phase;"
      OutputType=CMOT_Float1
      Description="Phase"
      Inputs(0)=(InputName="SunLightDir",Input=(Expression="/Script/Engine.MaterialExpressionSkyAtmosphereLightDirection'MF_SC_Phase:MaterialExpressionSkyAtmosphereLightDirection_3'"))
      Inputs(1)=(InputName="CameraPos",Input=(Expression="/Script/Engine.MaterialExpressionCameraPositionWS'MF_SC_Phase:MaterialExpressionCameraPositionWS_2'"))
