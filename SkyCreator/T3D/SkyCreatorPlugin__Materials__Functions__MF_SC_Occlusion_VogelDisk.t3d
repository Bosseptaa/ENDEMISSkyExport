   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/SkyCreatorPlugin/Materials/Functions/MF_SC_Occlusion_VogelDisk.MF_SC_Occlusion_VogelDisk:MaterialExpressionCustom_1'"
      Code="#define GOLDEN_RATIO (1.6180339887498948482045868343656381f)\r\n#define TWO_PI (6.28318530717f)\r\n\r\nstatic float Occlusion;\r\nstatic float OcclusionWorldHeight;\r\nfloat gradientNoise = TWO_PI * InterleavedGradientNoise(ScreenSize);\r\n\r\nfor (int i = 0; i < Samples; i++){\r\n\r\n    float2 sampleUV = VogelDiskSample(i, Samples, gradientNoise);\r\n\tOcclusionWorldHeight = Texture2DSample(Tex, TexSampler, UV + sampleUV * Offset);\r\n\t\r\n\tOcclusion += WorldHeight > OcclusionWorldHeight ? 0.0 : 1.0;}\r\n\r\nreturn Occlusion/Samples;"
      OutputType=CMOT_Float1
      Description="Vogel Disk Occlusion Sampling"
      Inputs(0)=(InputName="WorldHeight",Input=(Expression="/Script/Engine.MaterialExpressionNamedRerouteUsage'MF_SC_Occlusion_VogelDisk:MaterialExpressionNamedRerouteUsage_2'"))
      Inputs(1)=(InputName="Tex",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_SC_Occlusion_VogelDisk:MaterialExpressionFunctionInput_1'"))
      Inputs(2)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionNamedRerouteUsage'MF_SC_Occlusion_VogelDisk:MaterialExpressionNamedRerouteUsage_3'"))
      Inputs(3)=(InputName="Samples",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_SC_Occlusion_VogelDisk:MaterialExpressionFunctionInput_0'"))
      Inputs(4)=(InputName="Offset",Input=(Expression="/Script/Engine.MaterialExpressionDivide'MF_SC_Occlusion_VogelDisk:MaterialExpressionDivide_1'"))
      Inputs(5)=(InputName="ScreenSize",Input=(Expression="/Script/Engine.MaterialExpressionNamedRerouteUsage'MF_SC_Occlusion_VogelDisk:MaterialExpressionNamedRerouteUsage_4'"))
      IncludeFilePaths(0)="/Plugin/SkyCreatorPlugin/SkyCreatorCommon.ush"
      MaterialExpressionEditorX=-384
      MaterialExpressionEditorY=32
      MaterialExpressionGuid=74592AE848D9CD9442FE14845F031F0E
      Function="/Script/Engine.MaterialFunction'MF_SC_Occlusion_VogelDisk'"
      bCollapsed=True
   End Object
